# GEMINI_API_KEY: Required for Gemini API & Gemma 4 calls via @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PRIMARY_MODEL: Default Gemma 4 fast mixture-of-experts model.
PRIMARY_MODEL="gemma-4-26b-a4b-it"

# ALTERNATIVE_MODEL: Larger Gemma 4 model selectable via Test mode or env config.
ALTERNATIVE_MODEL="gemma-4-31b-it"

# FALLBACK_MODEL: Gemini Flash model used if Gemma fails after retries.
FALLBACK_MODEL="gemini-4-hydrogen"

# AUDIO_TRANSCRIBE_MODEL: Audio-capable Gemini model for transcribing voice input before Gemma 4 translation.
AUDIO_TRANSCRIBE_MODEL="gemini-3.5-transcribe"

# MODEL_ENDPOINT: Optional custom model server URL (leave empty to use Gemini API).
MODEL_ENDPOINT=""

# MODEL_API_KEY: Optional Bearer token if your custom MODEL_ENDPOINT requires auth.
MODEL_API_KEY=""
